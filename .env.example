# Example env — copy to .env and fill in

# Required for Gemini highlight clips:
GEMINI_API_KEY=

# Optional: path to Google OAuth client secrets (default: secrets/client_secrets.json)
# YOUTUBE_CLIENT_SECRETS=secrets/client_secrets.json
# YOUTUBE_TOKEN_PATH=secrets/token.json

# Optional overrides
# TOPICS_PATH=topics.yaml
# DATABASE_PATH=data/factory.db
# MEDIA_RAW_DIR=media/raw
# MEDIA_READY_DIR=media/ready
# MEDIA_ARCHIVE_DIR=media/archive
# ENABLE_SCHEDULER=true
# PRIVACY_STATUS=private
# APP_HOST=127.0.0.1
# APP_PORT=8010
# Optional: ffmpeg bin folder if PATH is stale
# FFMPEG_PATH=C:\Users\User\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin

# Ollama alternative (set llm_provider: ollama in topics.yaml)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
